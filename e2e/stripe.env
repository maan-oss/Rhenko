# Settings for the server when the payment checks run (E2E_STRIPE=1). These are test values for the stand-in Stripe in
# e2e/lib/stripe-mock.mjs, not live keys. Start the server with them, for example:
#   set -a; . e2e/stripe.env; set +a; NODE_ENV=production node_modules/.bin/next start -p 3300
# and run the suite with E2E_STRIPE=1 BASE_URL=http://127.0.0.1:3300 node e2e/run.mjs
# RHENKO_PUBLIC_URL must be the address the browser uses, because Stripe sends people back to it.
STRIPE_SECRET_KEY=sk_test_e2e_not_real
STRIPE_WEBHOOK_SECRET=whsec_e2e
RHENKO_PUBLIC_URL=http://127.0.0.1:3300
RHENKO_STRIPE_API_URL=http://127.0.0.1:4555
RHENKO_STRIPE_PRICE_PLUS=price_plus_e2e
RHENKO_STRIPE_PRICE_VERIFIED=price_verified_e2e
RHENKO_CURRENCY=usd
RHENKO_TIP_AMOUNTS=3,5,10
RHENKO_TIP_FEE_PERCENT=10
RHENKO_PAYOUT_COUNTRY=US
