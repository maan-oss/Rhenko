# Copy this file to .env and uncomment what you need. Every setting is optional, and a line that starts with # is off.
# In production the sign-in cookie is marked Secure, so serve the app over HTTPS. Voice calls need HTTPS too.

# Production settings. Compose reads them from this file. For npm run dev, DATABASE_URL and RHENKO_STORAGE=local are enough.

# The Postgres database, as a URL: postgres://user:password@host:5432/database. Compose builds this one itself from POSTGRES_PASSWORD.
# DATABASE_URL=postgres://rhenko:change-me@localhost:5432/rhenko

# The password of the Postgres database that Compose starts. Use letters and digits only, for example the output of: openssl rand -hex 24
# POSTGRES_PASSWORD=

# The domain people reach the app on, with its DNS record already pointing at this server. Caddy gets the HTTPS certificate for it.
# RHENKO_DOMAIN=rhenko.example.com

# The address people use, with https, for example https://rhenko.example.com. Passkeys and Stripe checkout links are built from it.
# RHENKO_PUBLIC_URL=https://rhenko.example.com

# Where uploads are kept: r2 (Cloudflare R2, the production choice), local (a folder under RHENKO_DATA_DIR, for development), or
# supabase. Compose sets r2 itself. Without any of these, the app looks for Supabase settings and fails if they are not there.
# RHENKO_STORAGE=local

# Cloudflare R2, used when RHENKO_STORAGE is r2. The endpoint is the account's S3 address. The backups go to the same bucket, under db-backups/.
# RHENKO_R2_ENDPOINT=https://<account-id>.r2.cloudflarestorage.com
# RHENKO_R2_BUCKET=rhenko-media
# RHENKO_R2_ACCESS_KEY_ID=
# RHENKO_R2_SECRET_ACCESS_KEY=

# The port the server listens on when it is started with npm start. Docker Compose ignores it: Caddy serves ports 80 and 443.
# PORT=3000

# How many worker processes serve the app on that port. Default 4, or the number of CPUs when there are fewer.
# RHENKO_WORKERS=4

# The folder that holds the server key when RHENKO_SECRET is not set, and the uploads when RHENKO_STORAGE is local. Default ./data. Docker Compose fixes it at /app/data.
# RHENKO_DATA_DIR=./data

# Protects stored two-factor keys. At least 16 characters, anything shorter is ignored. Without it the server makes data/secret.key on first use. The database backups do not include that file, so in production set this and keep a copy somewhere safe: lose the key and those two-factor keys cannot be read.
# RHENKO_SECRET=

# Outgoing email for verification and password-reset codes, as a URL such as smtps://user:password@smtp.example.com:465. Without it, in production, email features say email is not set up.
# RHENKO_SMTP_URL=

# The sender of those emails. Default: Rhenko <no-reply@localhost>.
# RHENKO_MAIL_FROM=Rhenko <no-reply@example.com>

# A translation service that speaks the LibreTranslate interface (POST /translate), such as a self-hosted LibreTranslate. Without it,
# no translate button appears. Only the text of the one post or message a reader asks to translate is sent to it.
# RHENKO_TRANSLATE_URL=https://translate.example.com

# The key that translation service needs, if it has one.
# RHENKO_TRANSLATE_KEY=

# Sahayak, the AI account that answers a mention of @sahayak under a post, uses Sarvam AI. Leave RHENKO_SARVAM_KEY empty and
# Sahayak does not answer, and no question is kept. Only the question and the posts it replies to or quotes that the asker can
# see are sent to Sarvam. The key is never logged.
# RHENKO_SARVAM_KEY=
# RHENKO_SARVAM_URL=https://api.sarvam.ai/v1/chat/completions
# RHENKO_SARVAM_MODEL=sarvam-105b

# Your own STUN or TURN servers for voice calls, as JSON: [{"urls":"turn:turn.example.com:3478","username":"name","credential":"secret"}]. Without it calls use Google's public STUN server, which does not connect every network.
# RHENKO_ICE_SERVERS=

# Short-lived TURN logins made from the shared secret of a coturn server (use-auth-secret). Set this together with RHENKO_TURN_URLS.
# RHENKO_TURN_SECRET=

# The turn: or turns: addresses of that server, separated by commas.
# RHENKO_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349

# Set to 1 when a reverse proxy in front of the app sets X-Forwarded-For or X-Real-IP, so rate limits and the network checks see each visitor's own address. Leave it off when people reach the app directly.
# RHENKO_TRUST_PROXY=1

# The human check on sign-up, sign-in, password resets, and new follows, messages and posts from accounts that look automated.
# Without these two, the check is a puzzle that runs in the visitor's browser and sends nothing to anyone. With both set, Cloudflare
# Turnstile is used instead and the server checks each answer with Cloudflare. Set both or neither.
# RHENKO_TURNSTILE_SITE_KEY=
# RHENKO_TURNSTILE_SECRET_KEY=
# Where answers are checked. Leave it empty to use Cloudflare's address.
# RHENKO_TURNSTILE_VERIFY_URL=
# How hard the built-in puzzle is, in zero bits from 8 to 22. The default is 16. Lower it only for tests.
# RHENKO_PROOF_BITS=

# Who runs this server, as shown on the Terms and Privacy pages. Without them those pages say no contact details have been published.
# RHENKO_OPERATOR_NAME=Example Ltd

# Where people can reach the operator about their data and reports, as shown on the Terms and Privacy pages.
# RHENKO_CONTACT_EMAIL=privacy@example.com

# The operator's postal address, shown on the Terms, Privacy Policy and copyright pages.
# RHENKO_OPERATOR_ADDRESS=

# The address for privacy requests and questions about data, shown on the Privacy Policy.
# RHENKO_PRIVACY_EMAIL=privacy@example.com

# India: the grievance officer under the IT Rules and the DPDP Act, and where to write to them.
# RHENKO_GRIEVANCE_OFFICER=Jane Example
# RHENKO_GRIEVANCE_EMAIL=grievance@example.com

# The copyright agent registered with the US Copyright Office, for notices under the DMCA. Shown on the copyright page.
# RHENKO_COPYRIGHT_AGENT_NAME=Example Ltd
# RHENKO_COPYRIGHT_AGENT_EMAIL=copyright@example.com
# RHENKO_COPYRIGHT_AGENT_ADDRESS=

# A representative in the EU and in the UK, when the operator is not established there and offers the service to people in them.
# RHENKO_EU_REPRESENTATIVE=
# RHENKO_UK_REPRESENTATIVE=

# Where the server is hosted, for example "Frankfurt, Germany". Shown on the Terms and Privacy Policy.
# RHENKO_HOSTING_LOCATION=

# The law the Terms are governed by, for example "England and Wales". Shown on the Terms.
# RHENKO_GOVERNING_LAW=
