# Copy this file to .env and uncomment what you need. Every setting is optional, and a line that starts with # is off.
# In production the sign-in cookie is marked Secure, so serve the app over HTTPS. Voice calls need HTTPS too.

# The port the server listens on. With Docker Compose it is the port published on the host; the container itself uses 3000.
# PORT=3000

# The folder that holds the database, the uploads and, unless RHENKO_SECRET is set, the server key. Default ./data. Docker Compose fixes it at /app/data.
# RHENKO_DATA_DIR=./data

# Protects stored two-factor keys. At least 16 characters, anything shorter is ignored. Without it the server makes data/secret.key on first use. Keep it with your backups: lose it and those keys cannot be read.
# RHENKO_SECRET=

# Outgoing email for verification and password-reset codes, as a URL such as smtps://user:password@smtp.example.com:465. Without it, in production, email features say email is not set up.
# RHENKO_SMTP_URL=

# The sender of those emails. Default: Rhenko <no-reply@localhost>.
# RHENKO_MAIL_FROM=Rhenko <no-reply@example.com>

# A translation service that speaks the LibreTranslate interface (POST /translate), such as a self-hosted LibreTranslate. Without it,
# no translate button appears. Only the text of the one post or message a reader asks to translate is sent to it.
# RHENKO_TRANSLATE_URL=https://translate.example.com

# The key that translation service needs, if it has one.
# RHENKO_TRANSLATE_KEY=

# Your own STUN or TURN servers for voice calls, as JSON: [{"urls":"turn:turn.example.com:3478","username":"name","credential":"secret"}]. Without it calls use Google's public STUN server, which does not connect every network.
# RHENKO_ICE_SERVERS=

# Short-lived TURN logins made from the shared secret of a coturn server (use-auth-secret). Set this together with RHENKO_TURN_URLS.
# RHENKO_TURN_SECRET=

# The turn: or turns: addresses of that server, separated by commas.
# RHENKO_TURN_URLS=turn:turn.example.com:3478,turns:turn.example.com:5349

# Set to 1 when a reverse proxy in front of the app sets X-Forwarded-For, so rate limits see each visitor's own address. Leave it off when people reach the app directly.
# RHENKO_TRUST_PROXY=1

# Who runs this server, as shown on the Terms and Privacy pages. Without them those pages say no contact details have been published.
# RHENKO_OPERATOR_NAME=Example Ltd

# Where people can reach the operator about their data and reports, as shown on the Terms and Privacy pages.
# RHENKO_CONTACT_EMAIL=privacy@example.com

# The operator's postal address, shown on the Terms, Privacy Policy and copyright pages.
# RHENKO_OPERATOR_ADDRESS=

# The address for privacy requests and questions about data, shown on the Privacy Policy.
# RHENKO_PRIVACY_EMAIL=privacy@example.com

# India: the grievance officer under the IT Rules and the DPDP Act, and where to write to them.
# RHENKO_GRIEVANCE_OFFICER=Jane Example
# RHENKO_GRIEVANCE_EMAIL=grievance@example.com

# The copyright agent registered with the US Copyright Office, for notices under the DMCA. Shown on the copyright page.
# RHENKO_COPYRIGHT_AGENT_NAME=Example Ltd
# RHENKO_COPYRIGHT_AGENT_EMAIL=copyright@example.com
# RHENKO_COPYRIGHT_AGENT_ADDRESS=

# A representative in the EU and in the UK, when the operator is not established there and offers the service to people in them.
# RHENKO_EU_REPRESENTATIVE=
# RHENKO_UK_REPRESENTATIVE=

# Where the server is hosted, for example "Frankfurt, Germany". Shown on the Terms and Privacy Policy.
# RHENKO_HOSTING_LOCATION=

# The law the Terms are governed by, for example "England and Wales". Shown on the Terms.
# RHENKO_GOVERNING_LAW=

# The folder scripts/backup.mjs writes backups to. Default ./backups. Docker Compose fixes it at /app/backups.
# RHENKO_BACKUP_DIR=./backups
